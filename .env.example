# Environment variables required by Custodian

# PostgreSQL connection string (Railway provides this automatically when attaching a PostgreSQL service)
DATABASE_URL=postgresql://user:password@host:5432/custodian

# Discord bot credentials (from Discord Developer Portal)
DISCORD_BOT_TOKEN=your_bot_token_here
CLIENT_ID=your_application_id_here
PUBLIC_KEY=your_public_key_here

# Optional: port to bind the HTTP server (Railway also sets this automatically)
PORT=3000
