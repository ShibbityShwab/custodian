{
  "name": "custodian",
  "version": "1.0.0",
  "description": "A lightweight Discord bot for cleaning up channel messages",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "keywords": [
    "discord",
    "bot",
    "cleanup",
    "moderation"
  ],
  "author": "ShibbityShwab",
  "license": "ISC",
  "dependencies": {
    "@discordjs/rest": "^2.4.0",
    "@hono/node-server": "^1.13.0",
    "discord-api-types": "^0.37.97",
    "discord-interactions": "^4.4.0",
    "discord.js": "^14.26.4",
    "hono": "^4.12.15",
    "node-cron": "^3.0.3",
    "pino": "^9.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.0",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.2.5",
    "vitest": "^3.2.0"
  }
}
